            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LeasingApplicationCreatedDto"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "submit-leasing-request-controller" ]
      }
    },
