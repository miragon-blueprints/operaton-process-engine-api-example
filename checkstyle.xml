<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  Source-structure rules that the compiler and ArchUnit (bytecode) cannot see — the Checkstyle
  successor to the former Konsist suite (see docs/adr/0014-architecture-tests-after-the-java-port.md):

  - OneTopLevelClass: one top-level type per file (SRP). javac only enforces this for *public* types;
    non-public siblings would still compile, so the rule earns its place.
  - AvoidStarImport: wildcard imports hide where a name comes from and invite accidental resolution
    changes when packages gain new types.
-->
<module name="Checker">
    <module name="TreeWalker">
        <module name="OneTopLevelClass"/>
        <module name="AvoidStarImport"/>
    </module>
</module>
